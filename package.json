{
  "name": "pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.netlify.json && vite build",
    "build:artifact": "vite build --mode artifact",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.netlify.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "check": "npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@netlify/blobs": "^11.1.2",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "gsap": "3.15.0",
    "lucide-react": "^0.460.0",
    "qrcode-generator": "^2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "simple-icons": "^16.34.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@playwright/test": "1.56.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.21.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.9"
  }
}
